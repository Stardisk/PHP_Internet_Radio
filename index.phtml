<html>
    <head>
        <title><?=config::getSetting('radioName')?></title>
        <style>
            .block{
                width: 300px;
                border: 1px solid #aaa;
                background: #ccc;
                margin: 20px 0;
                padding: 5px;
            }
            .playWrp{
                display: flex;
                justify-content: space-between;
            }
        </style>
    </head>
    <body>
        <h1><?=config::getSetting('radioName')?></h1>
        <p>Download file for media players: <a href="service.php?action=playlist&type=m3u" download="listen.m3u">m3u</a> | <a href="service.php?action=playlist&type=xspf" download="listen.xspf">xspf</a></p>
        <div class="block" id="info">
            <p>Now playing: <span class="nowPlaying"><?=$_RESPONSE['nowPlaying']?></span></p>
            <?php if($this->debug):?>
                <p>File: <span class="File"><?=$_RESPONSE['File']?></span></p>
                <p>Chunk: <span class="Chunk"><?=$_RESPONSE['Chunk']?></span> of <span class="TotalChunks"><?=$_RESPONSE['TotalChunks']?></span></p>
                <p>Last updated: <span class="LastUpdated"><?=$_RESPONSE['LastUpdated']?></span></p>
                <p>Current Time: <span class="CurrentTime"><?=$_RESPONSE['CurrentTime']?></span></p>
            <?php endif;?>
            <p>Files in library: <?=$_RESPONSE['FilesInLibrary']?></p>
        </div>
        <?php if(service::isAllowed()):?>
            <div class="block" id="service">
                <p><a href="service.php?action=refresh">Refresh library</a> | <a href="service.php?action=test">Test mp3 files</a></p>
                <p><a href="service.php?action=clear_memory">Clear shared memory</a></p>
            </div>
        <?php endif;?>
        <div class="block playWrp">
            <div>
                <button id="play">Play</button>
                <span class="playing"></span>
            </div>
            <div>
                <span class="volume"><input type="range" min="0" max="100" value="50"></span>
            </div>

        </div>
        <div class="block">
            <h3>Playing history</h3>
            <ul id="history">
                <?php if(is_array($_RESPONSE['History'])): ?>
                    <?php foreach($_RESPONSE['History'] as $item):?>
                        <li><?=$item?></li>
                    <?php endforeach;?>
                <?php else:?>
                    <li>[history is empty]</li>
                <?php endif;?>
            </ul>
        </div>

        <script>
            var playButton = document.getElementById('play');
            var volume = document.querySelector('.volume input');
            var audio = new Audio();
            var updateTimeInterval;
            audio.volume = 0.5;
            audio.addEventListener('canplay', function(){   this.play();});
            audio.addEventListener('error', function(e){
                alert('error'); console.log(e); console.log(e.name, e.message); playButton.style.display = '';
            });
            playButton.onclick = function(){
                if(!this.classList.contains('stop')){
                    var streamUrl = new URL('?play', location.href);
                    audio.src = streamUrl.href;
                    this.classList.add('stop');
                    this.textContent = 'Stop';
                    getStatus();

                    var playingTime = document.querySelector('.playing');
                    updateTimeInterval = setInterval(function(){
                        playingTime.innerText = addZeros(Math.floor(audio.currentTime / 60), 3)+':'+addZeros(Math.floor(audio.currentTime % 60),2);
                    },1000);
                }
                else{
                    audio.pause();
                    clearInterval(updateTimeInterval);
                    location.reload();
                }

            };
            volume.oninput = function(){ audio.volume = this.value / 100;};

            var xhr = new XMLHttpRequest(), info = document.getElementById('info');
            xhr.onreadystatechange = function(){
                if(xhr.readyState === 4){
                    var response = JSON.parse(xhr.responseText);
                    for(var key in response){
                        if(key === 'History' && response[key]){
                            var history = document.getElementById('history');
                            history.innerHTML = '';
                            response[key].forEach(function(historyItem){
                                let li = document.createElement('li');
                                li.textContent = historyItem;
                                history.appendChild(li);
                            });
                        }
                        else{
                            var div = document.querySelector('.'+key);
                            if(div) {info.querySelector('.'+key).textContent = response[key];}
                        }
                    }
                }
            };            
            setInterval(getStatus, 5000);

            function addZeros(number, lengthWithZeros){
                var numberAsString = String(number);
                var requiredZeros = lengthWithZeros - numberAsString.length;
                if(requiredZeros > 0){ return '0'.repeat(requiredZeros) + numberAsString;}
                else{ return numberAsString;}
            }

            function getStatus(){
                xhr.open('GET','?json');
                xhr.send();
            }

        </script>
    </body>
</html>
